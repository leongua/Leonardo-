//    Svuota Polilinea, SPLITCIR, CAMBIACOL, LEO_FUST, BLOCCHI_IN_PUNTI,
//    PLDREV_SHOW_DIRECTION, CONP, ED-SBOZ, CHECK_LINEE_INTERNE, SPESSORE,
